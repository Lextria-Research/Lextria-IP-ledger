# Copy this file to .env.local for local development,
# or set these directly in your Vercel project's Settings -> Environment Variables.
# Do not commit a real .env file — it is already ignored by .gitignore.

# ---------------------------------------------------------------------------
# SUPABASE (Primary Database Tier)
# Found in Supabase Dashboard -> Project Settings -> API:
#   - SUPABASE_URL: Project URL (e.g. https://xyz.supabase.co)
#   - SUPABASE_SERVICE_ROLE_KEY: service_role secret key (bypasses RLS for secure serverless API)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# LEXTRIA_API_KEY — the shared secret that gates the shared-backend API (api/state.js).
# ---------------------------------------------------------------------------
LEXTRIA_API_KEY=

# ---------------------------------------------------------------------------
# UPSTASH REDIS (Legacy / Fallback Storage)
# Optional fallback if Supabase is not configured.
# ---------------------------------------------------------------------------
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
